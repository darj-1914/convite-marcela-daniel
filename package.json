{
  "name": "refynce",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "type": "module",
  "description": "App pessoal para monitoramento financeiro com PostgreSQL, backend modular e frontend moderno.",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "build": "npm --prefix client run build",
    "start": "node src/server/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "node src/server/db/migrate.js",
    "db:seed": "node src/server/db/seed.js",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
